# Copy to .env (gitignored) and fill in. Leave blank to run on seeded fixtures.
# Slack app bot token (read-only scopes: channels:history, channels:read, users:read)
SLACK_BOT_TOKEN=
# Comma-separated channel IDs the bot has been added to, e.g. C0123ABCD,C0456EFGH
SLACK_CHANNEL_IDS=
# Secret iCal address of the hardware/team calendar (Google: Settings > Integrate calendar)
CALENDAR_ICS_URL=
# Optional: enables the Claude agent (reads the records, writes the card, talks to the engineer); without it Burn falls back to rules
ANTHROPIC_API_KEY=
