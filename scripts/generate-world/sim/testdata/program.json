 "storylines": [
  {
   "id": "sl-hip-cyclo-vs-harmonic",
   "name": "Hip reducer: cycloidal or harmonic",
   "team": "t-mech-actuators",
   "topic": "Whether the hip keeps the in-house cycloidal reducer or buys a harmonic drive for DVT",
   "people": [
    "p-arjun",
    "p-tomas",
    "p-owen",
    "p-ingrid"
   ],
   "start": "2026-02-16",
   "end": "2026-03-27",
   "beats": [
    {
     "week": "2026-02-16",
     "summary": "Tomas argues harmonic for the hip too: knee CSF-25 has 0.7 arcmin lost motion vs ~6 arcmin on our cyclo."
    },
    {
     "week": "2026-02-23",
     "summary": "Arjun pushes back: harmonic flexspline fatigue at hip peak torque (~140 Nm) is marginal, cyclo takes shock loads from drops."
    },
    {
     "week": "2026-03-02",
     "summary": "Owen prices both: harmonic set ~$1.9k per joint and 10-week lead; cyclo is machined parts plus pins, ~3 weeks."
    },
    {
     "week": "2026-03-16",
     "summary": "Ingrid asks for a decision memo; Tomas concedes backdrivability favors cyclo for the hip at 50:1."
    },
    {
     "week": "2026-03-23",
     "summary": "Decision: hip stays cycloidal through DVT, revisit for PVT; knee stays harmonic."
    }
   ]
  },
  {
   "id": "sl-hip-overheat-torque",
   "name": "Hip stator overheating at continuous torque",
   "team": "t-mech-actuators",
   "topic": "Hip winding hits 120 C after 4 min at 60 Nm continuous on the dyno",
   "people": [
    "p-nadia",
    "p-arjun",
    "p-andre",
    "p-bao"
   ],
   "start": "2026-04-13",
   "end": "2026-06-05",
   "beats": [
    {
     "week": "2026-04-13",
     "summary": "Andre: EVT hip hits the 120 C winding limit after ~4 min at 60 Nm, spec says 10 min."
    },
    {
     "week": "2026-04-20",
     "summary": "Nadia suspects poor stator-to-housing contact; thermal pad is 0.5 mm and compresses unevenly."
    },
    {
     "week": "2026-04-20",
     "summary": "Bao notes current ripple at 20 kHz PWM adds copper loss; asks to try 40 kHz on the driver."
    },
    {
     "week": "2026-05-04",
     "summary": "Heat spreader plate prototype drops steady-state by 14 C; housing fin redesign debated vs cost."
    },
    {
     "week": "2026-05-18",
     "summary": "Arjun accepts heat spreader for DVT, fins deferred; firmware derate at 105 C as a backstop."
    },
    {
     "week": "2026-06-01",
     "summary": "Retest with spreader and 40 kHz: 9.5 min to limit, close enough to sign off for EVT."
    }
   ]
  }
 ],
